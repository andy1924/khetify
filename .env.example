# Copy to .env.local in the khetify project root. Only a backend URL belongs here.
# In development, Expo Go replaces localhost with the computer's Expo LAN host.
# Use the same Wi-Fi and start the backend with PRICE_API_HOST=0.0.0.0.
# Expo tunnels only forward Metro; use a reachable HTTPS backend for tunnel mode.
EXPO_PUBLIC_FIELD_API_URL=http://localhost:8787
