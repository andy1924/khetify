{
  "expo": {
    "name": "Khetify",
    "slug": "khetify",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "khetify",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.khetify.demo",
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a plant photo for an assessment you explicitly approve.",
          "cameraPermission": "Take a plant photo for a health assessment.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFCF9"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Khetify to use your location to help you find and draw your field on the map.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
