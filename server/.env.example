# Copy to .env.local. Keep this server-side; never use an EXPO_PUBLIC variable.
PRICE_API_HOST=127.0.0.1
PRICE_API_PORT=8787
PRICE_ALLOWED_ORIGIN=http://localhost:8081
# Set to local to serve real downloaded archive records without price-feed keys.
PRICE_PROVIDER=government
DATA_GOV_API_KEY=
# Enable after verifying live feed access, fields, INR/quintal units and source terms.
PRICE_SOURCE_VERIFIED=false
OSM_USER_AGENT=Khetify/1.0 (https://github.com/andy1924/khetify)
NOMINATIM_URL=https://nominatim.openstreetmap.org/
# Crop photos are sent only with request consentToVision=true.
OPENAI_API_KEY=
# Choose an image-input + Structured Outputs compatible model available to your account.
CROP_VISION_MODEL=
# Plant-health photo assessment (image-input + Structured Outputs compatible model).
# Falls back to CROP_VISION_MODEL, then gpt-4.1-mini. Never put the key in EXPO_PUBLIC_*.
PLANT_HEALTH_MODEL=gpt-4.1-mini
# Specialized object detector with validation for each configured crop (never a general LLM).
# Also requires .price-data/grain-detector.json validation/retention manifest.
GRAIN_DETECTOR_URL=
GRAIN_DETECTOR_TOKEN=

# Satellite monitoring: Copernicus Data Space OAuth client (backend only).
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
